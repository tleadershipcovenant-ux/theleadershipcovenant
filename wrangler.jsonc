{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "the-leadership-covenant",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "build": {
    "command": "npx opennextjs-cloudflare build"
  },
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://theleadershipcovenant.com",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_Dzvmh7YTo2Y9C0122xV3BQ_WZU4Z57R",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_Dzvmh7YTo2Y9C0122xV3BQ_WZU4Z57R",
    "NEXT_PUBLIC_SUPABASE_URL": "https://qyyipcbzualacxwfvsih.supabase.co",
    "CLOUDINARY_FOLDER": "tlc_payment_screenshots",
    "FIREBASE_PROJECT_ID": "the-leadership-covenant"
  }
}
