# ==============================================================================
# THE LEADERSHIP COVENANT — ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env.local and fill in your Supabase & Cloudinary credentials
# ==============================================================================

# 1. Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 2. Hidden Admin Portal (/AD_Admin) Credentials & JWT Session Secret
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_JWT_SECRET=replace-with-a-long-random-secret

# 3. Supabase Database Configuration (PostgreSQL CRM + CMS)
# Get these from: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# 4. Cloudinary Storage Configuration (Payment Screenshots & CMS Media)
# Get these from: Cloudinary Console -> Settings -> API Keys
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_FOLDER=tlc_payment_screenshots
