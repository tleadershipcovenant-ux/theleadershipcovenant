# ==============================================================================
# THE LEADERSHIP COVENANT — ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# 1. Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 2. Executive Admin Portal Session Secret (Admin users authenticate via Supabase Auth)
ADMIN_JWT_SECRET=tlc_jwt_hs256_secret_2026_leadership_covenant_8492017465a9c3e1

# 3. Supabase Database Configuration (PostgreSQL CRM + CMS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_REGION=eu-west-3
DATABASE_URL=postgresql://postgres.your-project-id:your-password@aws-1-eu-west-3.pooler.supabase.com:5432/postgres

# 4. Cloudinary Storage Configuration (Payment Screenshots & CMS Media)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_FOLDER=tlc_payment_screenshots
